{
  "id": "csv-viewer-plugin",
  "name": "CSV Viewer",
  "version": "0.2.0",
  "apiVersion": "0.2.0",
  "releaseDate": "2026-09-03",
  "description": "Preview .csv files with a plugin-owned CSV parser and Core table components.",
  "enabledByDefault": true,
  "page": "./page.json",
  "entrypoints": {
    "main": "./main.js"
  },
  "contributes": {
    "internalPage": {
      "id": "plugin:csv-viewer-plugin",
      "titleKey": "plugin.name",
      "titleFallback": "CSV Viewer",
      "tags": [
        "internal",
        "plugin",
        "viewer",
        "csv",
        "table"
      ],
      "aliases": [
        "csv viewer",
        "csv plugin",
        "table viewer plugin"
      ],
      "boost": 1
    },
    "actions": [],
    "viewers": [
      {
        "id": "csv",
        "titleKey": "viewers.csv.title",
        "titleFallback": "CSV Viewer",
        "descriptionKey": "viewers.csv.description",
        "descriptionFallback": "Preview CSV files as a table.",
        "extensions": [
          "csv"
        ]
      }
    ]
  },
  "i18n": "./i18n.json",
  "capabilities": {
    "files": {
      "read": "active-tab",
      "write": "none"
    }
  }
}
