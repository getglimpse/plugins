{
  "id": "pdf-viewer-plugin",
  "name": "PDF Viewer",
  "version": "0.2.0",
  "apiVersion": "0.2.0",
  "releaseDate": "2026-09-03",
  "description": "Preview .pdf files with lazy loading for large documents.",
  "enabledByDefault": true,
  "page": "./page.json",
  "entrypoints": {
    "main": "./main.js"
  },
  "contributes": {
    "internalPage": {
      "id": "plugin:pdf-viewer-plugin",
      "titleKey": "plugin.name",
      "titleFallback": "PDF Viewer",
      "tags": [
        "internal",
        "plugin",
        "viewer",
        "pdf"
      ],
      "aliases": [
        "pdf viewer",
        "pdf plugin",
        "file viewer plugin"
      ],
      "boost": 1
    },
    "actions": [],
    "viewers": [
      {
        "id": "pdf",
        "titleKey": "viewers.pdf.title",
        "titleFallback": "PDF Viewer",
        "descriptionKey": "viewers.pdf.description",
        "descriptionFallback": "Preview PDF files.",
        "extensions": [
          "pdf"
        ]
      }
    ]
  },
  "i18n": "./i18n.json",
  "capabilities": {
    "files": {
      "read": "active-tab",
      "write": "none"
    }
  }
}
