{
  "id": "numeric-calculator-plugin",
  "name": "Numeric Calculator",
  "version": "0.2.0",
  "apiVersion": "0.2.0",
  "releaseDate": "2026-09-03",
  "description": "A plugin version of the built-in numeric calculation page.",
  "enabledByDefault": true,
  "page": "./page.json",
  "entrypoints": {
    "main": "./main.js"
  },
  "contributes": {
    "internalPage": {
      "id": "plugin:numeric-calculator-plugin",
      "titleKey": "plugin.name",
      "titleFallback": "Numeric Calculator",
      "tags": [
        "internal",
        "plugin",
        "calculator",
        "numeric",
        "tool"
      ],
      "aliases": [
        "calculator plugin",
        "calc plugin",
        "numeric calculator",
        "numeric plugin",
        "math plugin",
        "数値計算",
        "電卓"
      ],
      "boost": 1
    },
    "actions": [
      {
        "id": "calculate",
        "titleKey": "actions.calculate.title",
        "titleFallback": "Calculate expression",
        "descriptionKey": "actions.calculate.description",
        "descriptionFallback": "Evaluate a numeric expression with mathjs."
      }
    ],
    "viewers": []
  },
  "i18n": "./i18n.json",
  "capabilities": {
    "files": {
      "read": "none"
    }
  }
}
