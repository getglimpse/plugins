{
  "id": "html-viewer-plugin",
  "name": "HTML Viewer",
  "version": "0.2.0",
  "apiVersion": "0.2.0",
  "releaseDate": "2026-09-03",
  "description": "Preview .html and .htm files by delegating rendering to the app WebView.",
  "enabledByDefault": true,
  "page": "./page.json",
  "entrypoints": {
    "main": "./main.js"
  },
  "contributes": {
    "internalPage": {
      "id": "plugin:html-viewer-plugin",
      "titleKey": "plugin.name",
      "titleFallback": "HTML Viewer",
      "tags": [
        "internal",
        "plugin",
        "viewer",
        "html"
      ],
      "aliases": [
        "html viewer",
        "html plugin",
        "web page viewer plugin"
      ],
      "boost": 1
    },
    "actions": [],
    "viewers": [
      {
        "id": "html",
        "titleKey": "viewers.html.title",
        "titleFallback": "HTML Viewer",
        "descriptionKey": "viewers.html.description",
        "descriptionFallback": "Preview HTML files through the app WebView.",
        "extensions": [
          "html",
          "htm"
        ]
      }
    ]
  },
  "capabilities": {
    "files": {
      "read": "active-tab",
      "write": "none"
    }
  }
}
