{
  "id": "date-calculator-plugin",
  "name": "Date Calculator",
  "version": "0.2.0",
  "apiVersion": "0.2.0",
  "releaseDate": "2026-09-03",
  "description": "A plugin version of the built-in date calculation page.",
  "enabledByDefault": true,
  "page": "./page.json",
  "entrypoints": {
    "main": "./main.js"
  },
  "contributes": {
    "internalPage": {
      "id": "plugin:date-calculator-plugin",
      "titleKey": "plugin.name",
      "titleFallback": "Date Calculator",
      "tags": [
        "internal",
        "plugin",
        "date",
        "calendar",
        "tool"
      ],
      "aliases": [
        "date plugin",
        "date calculator",
        "calendar plugin",
        "date calculation",
        "日付計算",
        "日付"
      ],
      "boost": 1
    },
    "actions": [
      {
        "id": "calculate",
        "titleKey": "actions.calculate.title",
        "titleFallback": "Calculate date expression",
        "descriptionKey": "actions.calculate.description",
        "descriptionFallback": "Evaluate a date expression relative to today."
      }
    ],
    "viewers": []
  },
  "i18n": "./i18n.json",
  "capabilities": {
    "files": {
      "read": "none"
    }
  }
}
