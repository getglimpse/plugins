{
  "id": "file-converter-template-plugin",
  "name": "File Converter Template",
  "version": "0.2.0",
  "apiVersion": "0.2.0",
  "releaseDate": "2026-09-04",
  "description": "A Converter tab template for text and Markdown file output.",
  "enabledByDefault": true,
  "page": "./page.json",
  "entrypoints": {
    "main": "./main.js"
  },
  "contributes": {
    "internalPage": {
      "id": "plugin:file-converter-template-plugin",
      "titleKey": "plugin.name",
      "titleFallback": "File Converter Template",
      "tags": ["internal", "plugin", "template", "converter", "file"],
      "aliases": ["file converter template", "converter template"],
      "boost": 1
    },
    "actions": [
      {
        "id": "convertFile",
        "titleKey": "actions.convertFile.title",
        "titleFallback": "Convert File",
        "descriptionKey": "actions.convertFile.description",
        "descriptionFallback": "Convert selected text or Markdown files.",
        "input": {
          "type": "file",
          "accept": ["text/plain", "text/markdown", ".txt", ".md", ".markdown"],
          "multiple": true,
          "maxBytes": 10485760,
          "maxFiles": 20
        },
        "output": {
          "type": "file",
          "directorySetting": "outputDirectory"
        }
      }
    ],
    "viewers": []
  },
  "i18n": "./i18n.json",
  "capabilities": {
    "files": {
      "read": "none",
      "write": "declared-output-directory"
    }
  },
  "settings": {
    "outputDirectory": {
      "type": "directory",
      "labelKey": "settings.outputDirectory.label",
      "labelFallback": "Output directory",
      "descriptionKey": "settings.outputDirectory.description",
      "descriptionFallback": "Directory where converted files are written.",
      "default": "downloads",
      "required": true
    }
  }
}
