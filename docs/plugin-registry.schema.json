{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/getglimpse/plugins/main/docs/plugin-registry.schema.json",
  "title": "Glimpse Plugin Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "apiVersion",
        "category",
        "description",
        "releaseDate",
        "fileName",
        "downloadUrl",
        "sha256",
        "repositoryUrl",
        "readmeUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "apiVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "downloadCount": {
          "type": "integer",
          "minimum": 0
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.+\\.glimpse-plugin\\.zip$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "releaseDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fileName": {
          "type": "string",
          "pattern": "\\.glimpse-plugin\\.zip$"
        },
        "repositoryUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/getglimpse/plugins$"
        },
        "readmeUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://raw\\.githubusercontent\\.com/getglimpse/plugins/main/[a-z0-9][a-z0-9._-]*/README\\.md$"
        }
      }
    }
  }
}
