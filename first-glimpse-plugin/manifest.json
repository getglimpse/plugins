{
  "id": "first-glimpse-plugin",
  "name": "First Glimpse",
  "version": "0.2.0",
  "apiVersion": "0.2.0",
  "releaseDate": "2026-09-03",
  "description": "A sample plugin that registers action logic from main.js and page layout from page.json.",
  "enabledByDefault": true,
  "page": "./page.json",
  "entrypoints": {
    "main": "./main.js"
  },
  "contributes": {
    "internalPage": {
      "id": "plugin:first-glimpse-plugin",
      "titleKey": "plugin.name",
      "titleFallback": "First Glimpse",
      "tags": [
        "internal",
        "plugin",
        "sample",
        "glimpse"
      ],
      "aliases": [
        "first",
        "first glimpse",
        "sample plugin"
      ],
      "boost": 1
    },
    "actions": [
      {
        "id": "hello",
        "titleKey": "actions.hello.title",
        "titleFallback": "Say hello",
        "descriptionKey": "actions.hello.description",
        "descriptionFallback": "Return a greeting from the fixture plugin."
      }
    ],
    "viewers": []
  },
  "i18n": "./i18n.json",
  "capabilities": {
    "files": {
      "read": "none"
    }
  }
}
